# Local n8n test URL. Leave blank to use Demo Mode.
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/leadflow-intake
# Neon Postgres connection string. Leave blank locally to use SQLite instead.
DATABASE_URL=
# Optional local AI settings (Ollama falls back to transparent rules if unavailable)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b
# Set this only after adding the same x-internal-api-secret header in n8n.
INTERNAL_API_SECRET=
